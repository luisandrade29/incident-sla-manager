    <label>Incidente de TI - Email de Alerta de SLA</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Alert_Setting</name><label>Obter configuração do alerta</label><locationX>176</locationX><locationY>180</locationY>
        <connector><targetReference>Send_Supervisor_Email</targetReference></connector>
        <faultConnector><targetReference>Set_Fault_Note</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>DeveloperName</field><operator>EqualTo</operator><value><stringValue>Default</stringValue></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Incident_Alert_Setting__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Save_Fault_Note</name><label>Guardar nota de falha</label><locationX>440</locationX><locationY>420</locationY>
